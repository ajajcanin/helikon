{
  "name": "helikon",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node --env-file-if-exists=.env.development ./node_modules/next/dist/bin/next build",
    "start": "node --env-file-if-exists=.env.development ./node_modules/next/dist/bin/next start",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "storybook": "storybook dev -p 6007",
    "build-storybook": "storybook build",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:import": "tsx --env-file-if-exists=.env.development --import ./scripts/no-server-only.mjs scripts/db-import.ts",
    "user:create": "tsx --env-file-if-exists=.env.development --import ./scripts/no-server-only.mjs scripts/user-create.ts",
    "postinstall": "prisma generate --no-hints || true",
    "db:dev-publish": "tsx --env-file-if-exists=.env.development --import ./scripts/no-server-only.mjs scripts/dev-publish.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1161.0",
    "@aws-sdk/s3-request-presigner": "3.1161.0",
    "@next/third-parties": "16.4.3",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "better-auth": "1.7.14",
    "clsx": "2.1.1",
    "decimal.js": "10.6.0",
    "exceljs": "4.4.0",
    "lucide-react": "1.63.0",
    "next": "16.4.3",
    "next-intl": "4.14.9",
    "nodemailer": "10.2.1",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-pretty": "13.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "resend": "6.22.0",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@neon/config": "1.10.0",
    "@storybook/addon-a11y": "10.6.5",
    "@storybook/nextjs-vite": "10.6.5",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "dotenv": "18.0.9",
    "jsdom": "30.1.3",
    "lefthook": "2.2.2",
    "prisma": "7.10.1",
    "storybook": "10.6.5",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@11.10.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  }
}
