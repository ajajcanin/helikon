# Resend - used only to store signups as contacts in an Audience.
# No email is ever sent, so no domain verification is required.
RESEND_API_KEY=
RESEND_AUDIENCE_ID=

# Public site URL, used to build absolute Open Graph/Twitter image URLs.
NEXT_PUBLIC_SITE_URL=https://helikon.ba

# Google Analytics 4 Measurement ID. Not secret (it's visible in every page's
# source), but only loads Analytics when set.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
