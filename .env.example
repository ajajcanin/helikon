# Copy to .env (./setup.sh does it for you). Never commit .env.

# Postgres. Local: Docker. Production: Neon's pooled URL here, and its direct URL in DIRECT_URL for migrations.
DATABASE_URL="postgresql://helikon:helikon@localhost:5435/helikon"
DIRECT_URL=""
TEST_DATABASE_URL="postgresql://helikon:helikon@localhost:5435/helikon_test"

# Public URL of the app (login, e-mails)
APP_URL="http://localhost:3000"
# Public site URL, used to build absolute Open Graph/Twitter image URLs
NEXT_PUBLIC_SITE_URL="https://helikon.ba"

# Better Auth: a long random string (`openssl rand -base64 32`)
BETTER_AUTH_SECRET=""

# Resend: e-mail on Vercel (needs a verified domain)
RESEND_API_KEY=""
EMAIL_FROM="Helikon <info@helikon.ba>"
# Local only: send every e-mail to Mailpit (web UI http://localhost:8026)
SMTP_HOST="localhost"
SMTP_PORT="1026"

# Cloudflare Turnstile. Empty = the check is skipped.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Object storage. Local: the S3 server from Docker. Production: Cloudflare R2.
S3_ENDPOINT="http://localhost:9100"
S3_BUCKET="helikon-media"
S3_ACCESS_KEY_ID="local"
S3_SECRET_ACCESS_KEY="local"
NEXT_PUBLIC_MEDIA_URL="http://localhost:9100/helikon-media"

# Google Analytics 4 Measurement ID. Empty = not loaded.
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# Protects /api/cron/*. Vercel sends it automatically once set there.
CRON_SECRET=""

# Set when the Pantheon connector exists. Empty = shown as not connected.
PANTHEON_URL=""

# "true" shows the maintenance page to visitors
MAINTENANCE_MODE=""

# Log level: debug | info | warn | error
LOG_LEVEL="info"
