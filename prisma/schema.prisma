// Helikon database schema.
// Tables are snake_case; fields are camelCase in code and snake_case in the database.
// Prices the customer pays: numeric(12,2), PDV included. Purchase costs: numeric(12,4). Never floats.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Catalogue ─────────────────────────────

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Category {
  id       Int     @id @default(autoincrement())
  slug     String  @unique
  name     String
  parentId Int?    @map("parent_id")
  sort     Int     @default(0)

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@map("category")
}

model Manufacturer {
  id       Int                @id @default(autoincrement())
  slug     String             @unique
  name     String             @unique
  lines    ManufacturerLine[]
  products Product[]

  @@map("manufacturer")
}

/// A maker's product line, e.g. Rich > Master Acrylic.
model ManufacturerLine {
  id             Int    @id @default(autoincrement())
  manufacturerId Int    @map("manufacturer_id")
  name           String
  sort           Int    @default(0)

  manufacturer Manufacturer @relation(fields: [manufacturerId], references: [id], onDelete: Restrict)
  products     Product[]

  @@unique([manufacturerId, name])
  @@map("manufacturer_line")
}

/// What a customer sees as one item, e.g. "Akrilna boja - Grey Blue - Sivoplava". Sizes are its variants.
model Product {
  id            Int           @id @default(autoincrement())
  slug          String        @unique
  name          String
  description   String?
  status        ProductStatus @default(DRAFT)
  categoryId    Int?          @map("category_id")
  manufacturerId Int?         @map("manufacturer_id")
  lineId        Int?          @map("line_id")
  // Paint details from the design; empty for tools and other non-paint items.
  colourFamily  String?       @map("colour_family")
  medium        String?
  series        String?
  pigmentCode   String?       @map("pigment_code")
  singlePigment Boolean?      @map("single_pigment")
  lightfastness String?
  opacity       String?
  binder        String?
  /// Bosnian colour name, e.g. "Okeansko plava"
  colourName    String?       @map("colour_name")
  /// The maker's own name, e.g. "Okyanus Mavi", "Grey Blue"
  colourNameMaker String?     @map("colour_name_maker")
  /// The maker's shade number, e.g. 48
  colourCode    String?       @map("colour_code")
  finish        String?
  /// [{ "label": "Baza", "value": "voda" }]
  specs         Json?
  // TEMPORARY, for the confirmation page (/admin/potvrda). See docs/architecture.md to remove once all are confirmed.
  /// Where the data came from and what to check. Staff only.
  reviewNote    String?       @map("review_note")
  confirmed     Boolean       @default(false)
  confirmedAt   DateTime?     @map("confirmed_at")
  confirmedBy   String?       @map("confirmed_by")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  category Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  manufacturer Manufacturer? @relation(fields: [manufacturerId], references: [id], onDelete: SetNull)
  line     ManufacturerLine? @relation(fields: [lineId], references: [id], onDelete: SetNull)
  variants ProductVariant[]
  photos   ProductPhoto[]

  @@index([status])
  @@index([categoryId])
  @@index([confirmed])
  @@map("product")
}

/// What is actually sold and counted: one šifra, one size, one price, one stock level.
model ProductVariant {
  id        Int      @id @default(autoincrement())
  productId Int      @map("product_id")
  sku       String   @unique
  /// The item's id in the financial system, when it differs from the šifra
  externalId String? @unique @map("external_id")
  /// "120 ml", "50x70 cm"; empty when the item comes in one form only
  size      String?
  price     Decimal  @db.Decimal(12, 2)
  /// PDV included in price, in percent. 0 while the firm is outside the PDV system.
  taxRate   Decimal  @default(0) @map("tax_rate") @db.Decimal(5, 2)
  /// Never below zero (check constraint); changed only together with a StockMovement.
  stockQty  Int      @default(0) @map("stock_qty")
  active    Boolean  @default(true)
  sort      Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  product    Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  cost       VariantCost?
  movements  StockMovement[]
  orderLines OrderLine[]

  @@index([productId])
  @@map("product_variant")
}

/// Purchase data, in its own table so public queries can't select it by accident. Admin only.
model VariantCost {
  variantId   Int      @id @map("variant_id")
  purchaseUsd Decimal? @map("purchase_usd") @db.Decimal(12, 4)
  purchaseKm  Decimal? @map("purchase_km") @db.Decimal(12, 4)
  margin      Decimal? @db.Decimal(6, 2)
  updatedAt   DateTime @updatedAt @map("updated_at")

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@map("variant_cost")
}

model ProductPhoto {
  id        Int     @id @default(autoincrement())
  productId Int     @map("product_id")
  /// Key prefix in object storage; the sizes sit under it (see server/images.ts)
  storageKey String @map("storage_key")
  alt       String?
  width     Int
  height    Int
  sort      Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sort])
  @@map("product_photo")
}

enum StockReason {
  IMPORT
  ORDER
  ORDER_CANCELLED
  RETURN
  ADJUSTMENT
  SYNC
}

model StockMovement {
  id        Int         @id @default(autoincrement())
  variantId Int         @map("variant_id")
  delta     Int
  reason    StockReason
  orderId   Int?        @map("order_id")
  note      String?
  at        DateTime    @default(now())

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  order   Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([variantId, at])
  @@map("stock_movement")
}

// ───────────────────────────── Orders ─────────────────────────────

enum OrderStatus {
  NEW
  CONFIRMED
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentMethod {
  CASH_ON_DELIVERY
  BANK_TRANSFER
  CARD
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
}

model DeliveryRate {
  id       Int      @id @default(autoincrement())
  name     String
  price    Decimal  @db.Decimal(12, 2)
  /// Delivery is free when goods reach this amount
  freeFrom Decimal? @map("free_from") @db.Decimal(12, 2)
  active   Boolean  @default(true)
  sort     Int      @default(0)

  orders Order[]

  @@map("delivery_rate")
}

/// Guest checkout. Everything needed later is copied here, so old orders never change with the catalogue.
model Order {
  id             Int           @id @default(autoincrement())
  number         String        @unique
  /// Sent by the checkout page; a double click or retry returns the same order
  checkoutKey    String        @unique @map("checkout_key")
  /// Set once the order is in the financial system
  externalId     String?       @map("external_id")
  exportedAt     DateTime?     @map("exported_at")
  status         OrderStatus   @default(NEW)
  paymentMethod  PaymentMethod @map("payment_method")
  paymentStatus  PaymentStatus @default(PENDING) @map("payment_status")
  customerName   String        @map("customer_name")
  email          String
  phone          String
  address        String
  city           String
  postalCode     String        @map("postal_code")
  customerNote   String?       @map("customer_note")
  deliveryRateId Int?          @map("delivery_rate_id")
  deliveryName   String        @map("delivery_name")
  subtotal       Decimal       @db.Decimal(12, 2)
  deliveryPrice  Decimal       @map("delivery_price") @db.Decimal(12, 2)
  taxTotal       Decimal       @map("tax_total") @db.Decimal(12, 2)
  total          Decimal       @db.Decimal(12, 2)
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  deliveryRate DeliveryRate?   @relation(fields: [deliveryRateId], references: [id], onDelete: SetNull)
  lines        OrderLine[]
  events       OrderEvent[]
  movements    StockMovement[]
  documents    Document[]

  @@index([status, createdAt])
  @@index([email])
  @@map("order")
}

model OrderLine {
  id        Int     @id @default(autoincrement())
  orderId   Int     @map("order_id")
  variantId Int     @map("variant_id")
  sku       String
  name      String
  size      String?
  unitPrice Decimal @map("unit_price") @db.Decimal(12, 2)
  taxRate   Decimal @map("tax_rate") @db.Decimal(5, 2)
  qty       Int
  lineTotal Decimal @map("line_total") @db.Decimal(12, 2)

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@map("order_line")
}

model OrderEvent {
  id         Int          @id @default(autoincrement())
  orderId    Int          @map("order_id")
  fromStatus OrderStatus? @map("from_status")
  toStatus   OrderStatus  @map("to_status")
  note       String?
  userId     String?      @map("user_id")
  userName   String?      @map("user_name")
  at         DateTime     @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([orderId, at])
  @@map("order_event")
}

enum DocumentType {
  PREDRACUN
  RACUN
}

/// A predračun or račun issued for an order.
model Document {
  id         Int          @id @default(autoincrement())
  type       DocumentType
  number     String
  orderId    Int          @map("order_id")
  storageKey String?      @map("storage_key")
  issuedAt   DateTime     @default(now()) @map("issued_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([type, number])
  @@map("document")
}

/// Gapless numbers per series and year, e.g. orders, predračuni, računi.
model NumberCounter {
  series String
  year   Int
  value  Int    @default(0)

  @@id([series, year])
  @@map("number_counter")
}

// ───────────────────────────── Financial system (Pantheon, POS) ─────────────────────────────

enum SyncStatus {
  RUNNING
  SUCCESS
  FAILED
}

/// One exchange with an outside system, so staff can see when it last worked.
model SyncRun {
  id         Int        @id @default(autoincrement())
  system     String
  /// stock | prices | sales | orders
  kind       String
  status     SyncStatus @default(RUNNING)
  startedAt  DateTime   @default(now()) @map("started_at")
  finishedAt DateTime?  @map("finished_at")
  processed  Int        @default(0)
  failed     Int        @default(0)
  error      String?

  sales ExternalSale[]

  @@index([system, startedAt])
  @@map("sync_run")
}

/// A sale made outside the webshop, e.g. in the store. For analytics only: stock comes from the system's stock levels.
model ExternalSale {
  id         Int      @id @default(autoincrement())
  system     String
  externalId String   @map("external_id")
  soldAt     DateTime @map("sold_at")
  sku        String
  name       String?
  qty        Int
  revenue    Decimal  @db.Decimal(12, 2)
  cost       Decimal? @db.Decimal(12, 4)
  syncRunId  Int?     @map("sync_run_id")

  syncRun SyncRun? @relation(fields: [syncRunId], references: [id], onDelete: SetNull)

  @@unique([system, externalId])
  @@index([soldAt])
  @@map("external_sale")
}

// ───────────────────────────── Journal ─────────────────────────────

model Article {
  id          Int       @id @default(autoincrement())
  slug        String    @unique
  title       String
  excerpt     String?
  /// Markdown
  body        String
  coverKey    String?   @map("cover_key")
  publishedAt DateTime? @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([publishedAt])
  @@map("article")
}

// ───────────────────────────── System ─────────────────────────────

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("setting")
}

/// Append-only (database trigger). Changed fields only, never customer data.
model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    String?  @map("user_id")
  /// Name at the time, so the log stays readable if a user is renamed
  userName  String?  @map("user_name")
  at        DateTime @default(now())
  /// create | update | delete | bulk | import | status | settings …
  action    String
  tableName String   @map("table_name")
  recordId  String?  @map("record_id")
  /// Human-readable summary in Bosnian
  summary   String?
  /// Changed fields: { field: [old, new] } or details for bulk actions
  changes   Json?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tableName, recordId])
  @@index([at])
  @@index([userId])
  @@map("audit_log")
}

/// Shared rate limit for public forms and checkout: Vercel runs many instances that don't share memory.
model RateCounter {
  key         String   @id
  count       Int
  windowStart DateTime @map("window_start")

  @@index([windowStart])
  @@map("rate_counter")
}

// ───────────────────────────── Staff login (Better Auth) ─────────────────────────────

enum Role {
  ADMINISTRATOR
  UREDNIK
}

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false) @map("email_verified")
  image         String?
  role          Role      @default(UREDNIK)
  active        Boolean   @default(true)
  /// Admin colour mode: dark | light
  theme         String    @default("dark")
  failedLogins  Int       @default(0) @map("failed_logins")
  lockedUntil   DateTime? @map("locked_until")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  sessions    Session[]
  accounts    Account[]
  auditLogs   AuditLog[]
  orderEvents OrderEvent[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime @map("expires_at")
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verification")
}

model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt @map("last_request")

  @@map("rate_limit")
}
